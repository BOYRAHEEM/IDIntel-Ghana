# IDIntel Ghana — Environment Configuration Template
# Copy to .env and fill in all values before running
# NEVER commit .env to version control

# ============================================================
# Application
# ============================================================
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=<generate-64-char-random-hex-with-openssl-rand-hex-32>

# ============================================================
# Database (PostgreSQL)
# ============================================================
DATABASE_URL=postgresql+asyncpg://idintel:devpassword@localhost:5432/idintel_dev
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379/0
REDIS_TLS=false

# ============================================================
# Elasticsearch
# ============================================================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# ============================================================
# Neo4j (Relationship graphs)
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword

# ============================================================
# Anthropic Claude AI
# ============================================================
ANTHROPIC_API_KEY=sk-ant-api03-<your-key>
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# ============================================================
# AWS
# ============================================================
AWS_REGION=af-south-1
AWS_S3_BUCKET_REPORTS=idintel-ghana-reports-dev
AWS_S3_BUCKET_AUDIT=idintel-ghana-audit-dev
AWS_KMS_KEY_ID=<kms-key-id-for-identity-encryption>
AWS_KMS_AUDIT_KEY_ID=<kms-key-id-for-audit-signing>

# ============================================================
# JWT Authentication
# ============================================================
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./keys/private_key.pem
JWT_PUBLIC_KEY_PATH=./keys/public_key.pem
JWT_EXPIRY_SECONDS=14400

# ============================================================
# NIA (Ghana Card) Integration
# ============================================================
NIA_API_BASE_URL=https://nia-staging.idintel.internal
NIA_API_CLIENT_CERT_PATH=./certs/nia/client.crt
NIA_API_CLIENT_KEY_PATH=./certs/nia/client.key
NIA_API_CA_CERT_PATH=./certs/nia/ca.crt
NIA_API_TIMEOUT_SECONDS=10

# ============================================================
# GIS (Immigration) Integration
# ============================================================
GIS_API_BASE_URL=https://gis-staging.idintel.internal
GIS_API_API_KEY=<gis-api-key>

# ============================================================
# Security
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=100
RATE_LIMIT_DEFAULT_PER_DAY=50000
IP_ALLOWLIST_ENABLED=false
MTLS_REQUIRED=false
MIN_TLS_VERSION=TLSv1.3
ALLOWED_CORS_ORIGINS=["http://localhost:3000"]

# ============================================================
# HashiCorp Vault (optional — uses AWS KMS in dev)
# ============================================================
VAULT_ENABLED=false
VAULT_ADDR=
VAULT_TOKEN=

# ============================================================
# Celery / RabbitMQ
# ============================================================
CELERY_BROKER_URL=amqp://idintel:devpassword@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================
# Monitoring
# ============================================================
SENTRY_DSN=
PROMETHEUS_ENABLED=true
